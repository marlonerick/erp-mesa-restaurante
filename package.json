{
  "name": "erp-mesa-restaurante",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.ts",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bddgen && playwright test",
    "db:up": "docker compose -f docker/compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker/compose.dev.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "npm run ts-script -- scripts/seed-dev.ts",
    "admin:create": "npm run ts-script -- scripts/admin-create.ts",
    "maintenance:purge": "npm run ts-script -- scripts/maintenance-purge.ts",
    "ts-script": "node --env-file-if-exists=.env --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/register-alias.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "drizzle-orm": "0.45.3",
    "mysql2": "3.24.4",
    "next": "16.3.6",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "8.0.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.6",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/mysql": "12.1.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "lefthook": "2.1.14",
    "playwright-bdd": "9.2.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
