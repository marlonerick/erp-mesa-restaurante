# Copie para .env e ajuste. Os valores abaixo são FICTÍCIOS e valem apenas para o MySQL
# de desenvolvimento (docker/compose.dev.yml). Nunca coloque segredos reais neste arquivo.

NODE_ENV=development

# Conexão da aplicação (usuário só com SELECT/INSERT/UPDATE/DELETE)
DATABASE_URL=mysql://erp_app:app_dev_only@localhost:3306/erp_dev

# Conexão usada apenas para aplicar migrations (usuário com DDL)
MIGRATOR_DATABASE_URL=mysql://erp_migrator:migrator_dev_only@localhost:3306/erp_dev

# Tamanho do pool de conexões MySQL
DB_POOL_SIZE=10

# Nível de log: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Endereço público do sistema (em produção: https://...). Define se os cookies são "Secure".
APP_ORIGIN=http://localhost:3000

# Só desenvolvimento: IPs (separados por vírgula) liberados para testar de outro aparelho da
# mesma rede. Rode `npm run dev -- -H 0.0.0.0` e abra http://<IP>:3000 no outro aparelho.
DEV_ALLOWED_ORIGINS=

# "true" somente atrás de um proxy que sobrescreve o X-Forwarded-For (IP real do cliente)
TRUST_PROXY=false
