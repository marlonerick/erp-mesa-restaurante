# Copie para deploy/.env.production NO SERVIDOR e preencha. Este arquivo de exemplo não tem
# segredos. O .env.production real NUNCA vai para o Git (está no .gitignore).
#
# Senhas: use só letras e números (vão dentro de endereços mysql://). Para gerar uma:
#   openssl rand -hex 24

# Domínio do sistema (o DNS precisa apontar para o IP da VPS antes de subir)
DOMAIN=sistema.seurestaurante.com.br
APP_ORIGIN=https://sistema.seurestaurante.com.br

MYSQL_ROOT_PASSWORD=troque-por-uma-senha-longa
APP_DB_PASSWORD=troque-por-outra-senha-longa
MIGRATOR_DB_PASSWORD=troque-por-mais-uma-senha-longa

# Versão da imagem (tag); "latest" por padrão
APP_VERSION=latest
LOG_LEVEL=info

# Backup (deploy/backup.sh): pasta local e destino EXTERNO opcional do rclone (ex.: "remoto:erp")
BACKUP_DIR=./backups
BACKUP_REMOTE=
